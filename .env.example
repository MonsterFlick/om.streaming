# ==============================================================================
# UNCOMPILED.OM STREAMING SUITE ENVIRONMENT CONFIGURATION (.env.local)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. YOUTUBE API INTEGRATION (FOR LIVE STATS & SUBSCRIBER GOAL)
# Obtain free from: https://console.cloud.google.com/ (Enable YouTube Data API v3)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_YOUTUBE_API_KEY=""
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=""
NEXT_PUBLIC_YOUTUBE_LIVE_VIDEO_ID=""

# ------------------------------------------------------------------------------
# 2. KICK PLATFORM INTEGRATION (ZERO API KEY NEEDED)
# Set your Kick channel username handle below (https://kick.com/uncompiled-om):
# ------------------------------------------------------------------------------
NEXT_PUBLIC_KICK_CHANNEL_USERNAME="uncompiled-om"

# ------------------------------------------------------------------------------
# 3. LOCAL OBS EVENT BRIDGE SERVER
# Default local port for OBS browser sources and local webhooks
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STUDIO_SERVER_URL="http://localhost:3000"
